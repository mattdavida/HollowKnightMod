<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <!-- Define build configurations -->
    <Configurations>Debug-MelonLoader;Release-MelonLoader;Debug-BepInEx;Release-BepInEx</Configurations>
  </PropertyGroup>

  <!-- Fallback: Default Debug/Release to MelonLoader if no specific config -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' OR '$(Configuration)' == 'Release'">
    <DefineConstants>$(DefineConstants);MELONLOADER</DefineConstants>
    <OutputPath>bin\MelonLoader\$(Configuration)\</OutputPath>
    <AssemblyName>HollowKnight.MelonLoader</AssemblyName>
  </PropertyGroup>

  <!-- MelonLoader Configuration -->
  <PropertyGroup Condition="$(Configuration.Contains('MelonLoader'))">
    <DefineConstants>$(DefineConstants);MELONLOADER</DefineConstants>
    <OutputPath>bin\MelonLoader\$(Configuration.Replace('-MelonLoader', ''))\</OutputPath>
    <AssemblyName>HollowKnight.MelonLoader</AssemblyName>
  </PropertyGroup>

  <!-- BepInEx Configuration -->
  <PropertyGroup Condition="$(Configuration.Contains('BepInEx'))">
    <DefineConstants>$(DefineConstants);BEPINEX</DefineConstants>
    <OutputPath>bin\BepInEx\$(Configuration.Replace('-BepInEx', ''))\</OutputPath>
    <AssemblyName>HollowKnight.BepInEx</AssemblyName>
  </PropertyGroup>

  <!-- Common Unity Engine References -->
  <ItemGroup>
